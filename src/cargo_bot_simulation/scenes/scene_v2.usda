def Scope "colliders"
{
    token visibility = "invisible"

    def Xform "base_footprint"
    {
    }

    def Xform "base_link"
    {
        def Xform "base_link" (
            prepend references = </meshes/base_link_0>
        )
        {
            uniform token purpose = "guide"
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (0.0010000000474974513, 0.0010000000474974513, 0.0010000000474974513)
            double3 xformOp:translate = (0, 0, 0)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient", "xformOp:scale"]

            over "node_STL_BINARY_" (
                prepend apiSchemas = ["PhysicsCollisionAPI", "PhysicsMeshCollisionAPI"]
            )
            {
                uniform token physics:approximation = "convexDecomposition"
            }
        }
    }

    def Xform "caster_wheel_link"
    {
        def Xform "caster_wheel" (
            prepend references = </meshes/caster_wheel_0>
        )
        {
            uniform token purpose = "guide"
            quatd xformOp:orient = (1, 0, 0, 0)
            double3 xformOp:scale = (0.0010000000474974513, 0.0010000000474974513, 0.0010000000474974513)
